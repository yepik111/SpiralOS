#!/usr/bin/env python3
import sys; sys.path.insert(0,"/usr/local/lib/spiralos")
from sgtk import *
w=win("SpiralOS "+t2("File search","Dateisuche"),660,520); box=Gtk.VBox(spacing=6,margin=8); w.add(box)
hb=Gtk.HBox(spacing=6); box.pack_start(hb,False,False,0)
e=Gtk.Entry(hexpand=True); fc=Gtk.FileChooserButton(title="Folder",action=Gtk.FileChooserAction.SELECT_FOLDER); fc.set_filename(os.path.expanduser("~"))
ls=Gtk.ListStore(str); tv=Gtk.TreeView(model=ls); tv.append_column(Gtk.TreeViewColumn(t2("Path","Pfad"),Gtk.CellRendererText(),text=0))
def go():
    ls.clear(); s=e.get_text().strip()
    if s:
        for p in subprocess.run(["find",fc.get_filename(),"-iname","*%s*"%s,"-not","-path","*/.*"],capture_output=True,text=True).stdout.splitlines()[:500]: ls.append([p])
e.connect("activate",lambda _e:go())
for x in (e,fc,button(t2("Search","Suchen"),go)): hb.pack_start(x,x is e,True,0)
sw=Gtk.ScrolledWindow(); sw.add(tv); box.pack_start(sw,True,True,0)
tv.connect("row-activated",lambda v,p,c:subprocess.Popen(["xdg-open",ls[p][0]])); run_app(w)
