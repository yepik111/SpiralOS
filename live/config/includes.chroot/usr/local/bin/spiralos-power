#!/usr/bin/env python3
import sys; sys.path.insert(0,"/usr/local/lib/spiralos")
from sgtk import *
css=Gtk.CssProvider(); css.load_from_data(b"window{background:rgba(20,26,36,0.96)} button{font-size:16px;padding:18px 26px} label{color:#e5e9f0}")
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
w=Gtk.Window(); w.fullscreen(); w.connect("destroy",Gtk.main_quit)
w.connect("key-press-event",lambda _w,e: w.destroy() if e.keyval==Gdk.KEY_Escape else None)
box=Gtk.HBox(spacing=14,halign=Gtk.Align.CENTER,valign=Gtk.Align.CENTER); w.add(box)
def act(cmd): subprocess.Popen(cmd,shell=True); w.destroy()
for label,cmd in ((t2("Lock","Sperren"),"xflock4"),(t2("Log out","Abmelden"),"xfce4-session-logout --logout"),(t2("Suspend","Ruhezustand"),"systemctl suspend"),(t(27),"systemctl reboot"),(t2("Shut down","Herunterfahren"),"systemctl poweroff"),(t(26),None)):
    box.pack_start(button(label,(lambda c=cmd:act(c)) if cmd else w.destroy),False,False,0)
run_app(w)
