#!/bin/sh
# Laeuft einmalig nach der Installation (Dienst spiralos-postinstall.service)
D=/var/lib/spiralos; mkdir -p "$D"
[ -f "$D/postinstall-done" ] && exit 0
rm -f /etc/ssh/sshd_config.d/05-live.conf
systemctl disable spiralos-live-ssh.service >/dev/null 2>&1
[ -f /etc/spiralos-version ] || echo 1.0.0 > /etc/spiralos-version
fc-cache -f >/dev/null 2>&1
/usr/local/bin/spiralos-snapshot create "fresh install" >/dev/null 2>&1
[ -f /etc/spiralos-flash ] || /usr/local/bin/spiralos-flash on >/dev/null 2>&1
touch "$D/postinstall-done"
exit 0
