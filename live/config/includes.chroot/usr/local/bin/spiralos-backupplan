#!/usr/bin/env python3
import sys; sys.path.insert(0,"/usr/local/lib/spiralos")
from sgtk import *
w=win("SpiralOS "+t2("Backup plan","Backup-Planer"),480,320); box=Gtk.VBox(spacing=8,margin=14); w.add(box)
src=Gtk.FileChooserButton(title="Source",action=Gtk.FileChooserAction.SELECT_FOLDER); src.set_filename(os.path.expanduser("~"))
dst=Gtk.FileChooserButton(title="Target",action=Gtk.FileChooserAction.SELECT_FOLDER); os.makedirs(os.path.expanduser("~/Backups"),exist_ok=True); dst.set_filename(os.path.expanduser("~/Backups"))
fr=Gtk.ComboBoxText(); [fr.append_text(x) for x in (t2("Daily","Täglich"),t2("Weekly","Wöchentlich"),t2("Off","Aus"))]; fr.set_active(1)
st=Gtk.Label()
def apply():
    U=os.path.expanduser("~/.config/systemd/user"); os.makedirs(U,exist_ok=True)
    if fr.get_active()==2:
        sh("systemctl --user disable --now spiralos-backup.timer"); st.set_text(t2("Backup plan disabled","Backup-Plan ausgeschaltet")); return
    open(U+"/spiralos-backup.service","w").write("[Unit]\nDescription=SpiralOS Backup\n[Service]\nType=oneshot\nExecStart=/usr/local/bin/spiralos-backup create '%s' '%s'\n"%(src.get_filename(),dst.get_filename()))
    open(U+"/spiralos-backup.timer","w").write("[Unit]\nDescription=SpiralOS Backup\n[Timer]\nOnCalendar=%s\nPersistent=true\n[Install]\nWantedBy=timers.target\n"%("daily" if fr.get_active()==0 else "weekly"))
    sh("systemctl --user daemon-reload; systemctl --user enable --now spiralos-backup.timer"); st.set_text(t2("Backup plan active","Backup-Plan aktiv"))
for x in (Gtk.Label(label=t2("Folder to back up","Zu sichernder Ordner")),src,Gtk.Label(label=t2("Save backups to","Backups speichern in")),dst,Gtk.Label(label=t2("Schedule","Zeitplan")),fr,button(t2("Apply","Übernehmen"),apply),st): box.pack_start(x,False,False,0)
run_app(w)
