#!/usr/bin/env python3
# Ueberwacht das System und zeigt Absturz-Bildschirme (laeuft in der Sitzung)
import os, glob, time, subprocess, shutil
cool={}; ev="/run/spiralos/events"; pos=os.path.getsize(ev) if os.path.exists(ev) else 0; low=0; had_net=False; down=0
def show(t,d=""):
    n=time.time()
    if n-cool.get(t,0)<180: return
    cool[t]=n; subprocess.Popen(["sudo","-n","/usr/local/bin/spiralos-crashlog",t,d],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); subprocess.Popen(["spiralos-crash",t,d])
def net_up():
    return any(open(p).read().strip()=="up" for p in glob.glob("/sys/class/net/*/operstate") if "/lo/" not in p)
while True:
    try:
        m={l.split(":")[0]:int(l.split()[1]) for l in open("/proc/meminfo")}
        low=low+1 if m["MemAvailable"]<0.05*m["MemTotal"] else 0
        if low>=2: show("oom","MemAvailable: %d MB"%(m["MemAvailable"]//1024))
        du=shutil.disk_usage("/")
        if du.used/du.total>=0.98: show("disk","Free: %d MB"%(du.free//2**20))
        tm=[int(open(x).read())/1000 for x in glob.glob("/sys/class/thermal/thermal_zone*/temp")]
        if tm and max(tm)>=95: show("heat","Temp: %.0f C"%max(tm))
        for b in glob.glob("/sys/class/power_supply/BAT*"):
            c=open(b+"/capacity").read().strip()
            dis=open(b+"/status").read().strip()=="Discharging"
            if dis and int(c)<=5: show("battery","Battery: %s %%"%c)
            elif dis and int(c)<=15 and time.time()-cool.get("bw",0)>900:
                cool["bw"]=time.time(); subprocess.Popen(["notify-send","-u","critical","SpiralOS","Battery low: %s %%"%c])
        if net_up(): had_net=True; down=0
        elif had_net:
            down+=1
            if down>=20: show("net","")
        if os.path.exists(ev):
            s=os.path.getsize(ev)
            if s<pos: pos=0
            if s>pos:
                with open(ev) as fh: fh.seek(pos); ls=fh.read().splitlines()
                pos=s
                for l in ls: t,_,d2=l.partition("|"); show(t,d2)
    except Exception: pass
    time.sleep(3)
