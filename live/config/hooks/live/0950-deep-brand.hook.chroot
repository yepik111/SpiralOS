#!/bin/sh
# Ersetzt sichtbare Fremd-Markennamen durch SpiralOS (Rechtliche Hinweise in /usr/share/doc bleiben erhalten)
# dpkg-Herkunft wie bei anderen Ableitungen: eigener Hersteller, Elternsystem nur technisch eingetragen
if [ -f /etc/dpkg/origins/debian ]; then
  printf 'Vendor: SpiralOS\nVendor-URL: https://github.com/yepik111/SpiralOS\nBugs: https://github.com/yepik111/SpiralOS/issues\nParent: Debian\n' > /etc/dpkg/origins/spiralos
  ln -sf spiralos /etc/dpkg/origins/default
fi
printf 'HOME_URL="https://github.com/yepik111/SpiralOS"\nSUPPORT_URL="https://github.com/yepik111/SpiralOS/issues"\nBUG_REPORT_URL="https://github.com/yepik111/SpiralOS/issues"\nANSI_COLOR="1;34"\n' >> /usr/lib/os-release
printf 'DISTRIB_ID=SpiralOS\nDISTRIB_RELEASE=1.0\nDISTRIB_CODENAME=helix\nDISTRIB_DESCRIPTION="SpiralOS 1.0 (Helix)"\n' > /etc/lsb-release
# Installer-Branding vollstaendig (auch Folien)
D=/usr/share/calamares/branding/spiralos
[ -d "$D" ] && grep -rIl 'Debian' "$D" 2>/dev/null | while read -r f; do sed -i 's/Debian GNU\/Linux/SpiralOS/g; s/Debian/SpiralOS/g' "$f"; done
# Debian-Designpaket entfernen, wenn dabei nichts anderes mit entfernt wird
if dpkg -s desktop-base >/dev/null 2>&1; then
  N=$(apt-get -s purge desktop-base 2>/dev/null | grep -c '^Remv')
  [ "${N:-9}" -le 2 ] && apt-get -y purge desktop-base >/dev/null 2>&1
fi
# Eigene Programme ersetzen die alten: alte bleiben installiert, aber unsichtbar (Notfall: Befehl im Terminal)
for f in /usr/share/applications/*mousepad*.desktop /usr/share/applications/*ristretto*.desktop /usr/share/applications/*FileRoller*.desktop /usr/share/applications/*file-roller*.desktop; do
  [ -f "$f" ] && ! grep -q '^NoDisplay=true' "$f" && sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$f"
done
for f in /usr/share/applications/*thunar.desktop /usr/share/applications/*Thunar.desktop; do
  [ -f "$f" ] && sed -i 's/^Name=Thunar File Manager/Name=Files/; s/^Name=Thunar/Name=Files/; s/^Name\[de\]=.*/Name[de]=Dateien/' "$f"
done
for f in /usr/share/applications/*xfce4-terminal*.desktop /usr/share/applications/*Terminal*.desktop; do
  [ -f "$f" ] && sed -i 's/^Name=Xfce Terminal/Name=Terminal/; s/^Name\[de\]=Xfce.*/Name[de]=Terminal/' "$f"
done
# Firefox: eigene Startseite, keine Standard-Lesezeichen und keine Fremd-Startseiten
mkdir -p /usr/lib/firefox-esr/distribution
[ -f /etc/firefox/policies/policies.json ] && cp /etc/firefox/policies/policies.json /usr/lib/firefox-esr/distribution/policies.json
# Standard-Hintergrund: eigenes Bild statt des Debian-Designs (fuer neue Benutzer, jeder Monitorname)
X=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml; mkdir -p "$X"; rm -f "$X/xfce4-desktop.xml"
{ echo '<?xml version="1.0" encoding="UTF-8"?>'; echo '<channel name="xfce4-desktop" version="1.0">'; echo ' <property name="backdrop" type="empty">'; echo '  <property name="screen0" type="empty">'
  for m in monitor0 monitor1 monitorVirtual1 monitorVirtual-1 monitorHDMI-1 monitorHDMI-A-1 monitoreDP-1 monitoreDP1 monitorLVDS-1 monitorDP-1 monitorVGA-1 monitorDVI-D-0 monitorDisplayPort-0 monitorHDMI-0 monitorXWAYLAND0; do
    printf '   <property name="%s" type="empty"><property name="workspace0" type="empty"><property name="color-style" type="int" value="0"/><property name="image-style" type="int" value="5"/><property name="last-image" type="string" value="/usr/share/backgrounds/spiralos/default.png"/></property></property>\n' "$m"
  done
  echo '  </property>'; echo ' </property>'; echo '</channel>'; } > "$X/xfce4-desktop.xml"
# UEFI-Eintrag heisst nach der Installation SpiralOS statt debian
[ -f /etc/calamares/modules/bootloader.conf ] && sed -i 's/^efiBootloaderId:.*/efiBootloaderId: "spiralos"/' /etc/calamares/modules/bootloader.conf
# Symbol-Cache
for t in SpiralOS hicolor; do gtk-update-icon-cache -f -t /usr/share/icons/$t >/dev/null 2>&1; done
fc-cache -f >/dev/null 2>&1
mandb -q >/dev/null 2>&1
exit 0
