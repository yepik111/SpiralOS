#!/bin/sh
# spiralos-timezone show|list|set <Zone>|ntp on|off
case "$1" in
  ""|show) timedatectl ;;
  list) timedatectl list-timezones ;;
  set) sudo timedatectl set-timezone "$2" && timedatectl | sed -n '1,4p' ;;
  ntp) [ "$2" = off ] && V=false || V=true; sudo timedatectl set-ntp $V && echo "NTP: $V" ;;
  *) echo "Usage: spiralos-timezone show|list|set Europe/Berlin|ntp on|off" ;;
esac
