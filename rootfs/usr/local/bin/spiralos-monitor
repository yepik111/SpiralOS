#!/usr/bin/env python3
import sys; sys.path.insert(0,'/usr/local/lib/spiralos'); from i18n import tk_t as t
import tkinter as tk, subprocess, shutil
from tkinter import ttk
root=tk.Tk(); root.title("SpiralOS Monitor"); root.geometry("560x520")
def bar(n):
    f=ttk.Frame(root,padding=(10,6)); f.pack(fill="x"); ttk.Label(f,text=n,width=11).pack(side="left")
    p=ttk.Progressbar(f,maximum=100); p.pack(side="left",fill="x",expand=True); v=ttk.Label(f,width=20); v.pack(side="left"); return p,v
cpu,cv=bar("CPU"); ram,rv=bar("RAM"); dsk,dv=bar(t(18))
net=ttk.Label(root,padding=10); net.pack(anchor="w")
cols=("pid","name","cpu","mem"); tv=ttk.Treeview(root,columns=cols,show="headings",height=14)
for c,t in zip(cols,("PID",t(19),"CPU %","RAM %")): tv.heading(c,text=t); tv.column(c,width=220 if c=="name" else 80)
tv.pack(fill="both",expand=True,padx=10,pady=6)
last=[0,0,0]
def tick():
    a=list(map(int,open("/proc/stat").readline().split()[1:])); t,i=sum(a),a[3]+a[4]
    if last[0] and t!=last[0]: u=100*(1-(i-last[1])/(t-last[0])); cpu["value"]=u; cv["text"]="%.0f %%"%u
    last[0],last[1]=t,i
    m={l.split(":")[0]:int(l.split()[1]) for l in open("/proc/meminfo")}; used=m["MemTotal"]-m["MemAvailable"]
    ram["value"]=100*used/m["MemTotal"]; rv["text"]="%.1f / %.1f GB"%(used/1048576,m["MemTotal"]/1048576)
    d=shutil.disk_usage("/"); dsk["value"]=100*d.used/d.total; dv["text"]="%.0f / %.0f GB"%(d.used/2**30,d.total/2**30)
    nbytes=0
    for l in open("/proc/net/dev").readlines()[2:]:
        n,x=l.split(":")
        if n.strip()!="lo": x=x.split(); nbytes+=int(x[0])+int(x[8])
    if last[2]: net["text"]=t(6)+": %.1f KB/s"%((nbytes-last[2])/1024)
    last[2]=nbytes
    tv.delete(*tv.get_children())
    for l in subprocess.run(["ps","-eo","pid,comm,%cpu,%mem","--sort=-%cpu","--no-headers"],capture_output=True,text=True).stdout.splitlines()[:15]: tv.insert("","end",values=l.split(None,3))
    root.after(1000,tick)
tick(); root.mainloop()
